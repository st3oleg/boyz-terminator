{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminator:schema:hub-event:v1",
  "title": "Evento dispositivo per hub Ubuntu, versione 1",
  "description": "Contratto proposto nella fase 1. Non è ancora usato dai servizi Rover e Base.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "device_type",
    "boot_id",
    "sequence",
    "event_type",
    "observed_at",
    "monotonic_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "device_type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "boot_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {
      "enum": ["status", "telemetry", "diagnostic_event", "mission_index"]
    },
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "monotonic_ms": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  }
}
